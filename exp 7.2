import React from "react";
import { useDispatch, useSelector } from "react-redux";
import { addToCart, removeFromCart, clearCart } from "./features/cart/cartSlice";
const products = [
  { id: 1, name: "Laptop", price: 70000 },
  { id: 2, name: "Headphones", price: 2500 },
  { id: 3, name: "Smartphone", price: 35000 },
];
function App() {
  const dispatch = useDispatch();
  const cart = useSelector(state => state.cart.items);
  const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
  return (
    <div style={{ textAlign: "center", marginTop: "40px" }}>
      <h1>🛒 Redux Toolkit Shopping Cart</h1>
      <h2>Products</h2>
      <div style={{ display: "flex", justifyContent: "center", gap: "20px" }}>
        {products.map(p => (
          <div key={p.id} style={{ border: "1px solid #ccc", padding: "10px", width: "180px" }}>
            <h3>{p.name}</h3>
            <p>₹{p.price}</p>
            <button onClick={() => dispatch(addToCart(p))}>Add to Cart</button>
          </div>
        ))}
      </div>
      <h2 style={{ marginTop: "40px" }}>Cart</h2>
      {cart.length === 0 ? (
        <p>Your cart is empty.</p>
      ) : (
        <>
          {cart.map(item => (
            <div key={item.id} style={{ margin: "10px auto", width: "300px" }}>
              {item.name} (x{item.quantity}) — ₹{item.price * item.quantity}
              <button
                onClick={() => dispatch(removeFromCart(item.id))}
                style={{ marginLeft: "10px" }}
              >
                Remove
              </button>
            </div>
          ))}
          <h3>Total: ₹{total}</h3>
          <button onClick={() => dispatch(clearCart())}>Clear Cart</button>
        </>
      )}
    </div>
  );
}
export default App;
//6️⃣ Run the app//
npm start

